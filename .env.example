# Optional PostgreSQL development profile. The default fixture mode needs no variables.
# Export these variables before launching the backend with phivealpha-persistence.
PHIVEALPHA_R2DBC_URL=r2dbc:postgresql://127.0.0.1:5432/phivealpha_dev_local
PHIVEALPHA_R2DBC_USERNAME=phivealpha_dev_local
PHIVEALPHA_R2DBC_PASSWORD=
